{
  "name": "kanaric",
  "version": "1.1.0",
  "description": "跨平台動態歌詞與聽歌分析系統",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "app": "electron.cmd .",
    "build:py": "if exist ..\\venv\\Scripts\\python.exe (..\\venv\\Scripts\\python.exe -m PyInstaller --noconfirm --onedir --name pytools --collect-data pykakasi --collect-all unidic_lite --collect-data fugashi --distpath ..\\dist-py --workpath ..\\build-py --specpath ..\\build-py ..\\pytools.py) else (..\\..\\Kanaric\\venv\\Scripts\\python.exe -m PyInstaller --noconfirm --onedir --name pytools --collect-data pykakasi --collect-all unidic_lite --collect-data fugashi --distpath ..\\dist-py --workpath ..\\build-py --specpath ..\\build-py ..\\pytools.py)",
    "dist": "npm run build:py && electron-builder",
    "test": "node ../tests/run_all.js"
  },
  "keywords": [],
  "author": "Resuaumis",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "opencc-js": "^1.4.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.resuaumis.kanaric",
    "productName": "Kanaric",
    "compression": "maximum",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Resuaumis",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron.js",
      "server.js",
      "karaoke-session.js",
      "karaoke-diagnostics.js",
      "karaoke-queue.js",
      "karaoke-remote.js",
      "karaoke-catalog.js",
      "song-library.js",
      "mpv-karaoke-player.js",
      "karaoke-player-service.js",
      "karaoke-stage-controller.js",
      "media-timing.js",
      "karaoke-library-scan.js",
      "s2t.js",
      "lyric-quality.js",
      "browser-query.js",
      "title-lines.js",
      "translations.js",
      "romaji.js",
      "word-times.js",
      "game.js",
      "island.js",
      "island-position.js",
      "preload-island.js",
      "win-corners.js",
      "remote-mobile.html",
      "views/**",
      "public/**"
    ],
    "extraResources": [
      {
        "from": "../dist-py/pytools",
        "to": "pytools"
      },
      {
        "from": "../third_party",
        "to": "third_party"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bensionfang",
        "repo": "Kanaric"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kanaric-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "sqlite3@5.1.7": true
  }
}
