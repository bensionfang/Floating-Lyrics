<%- include('header') %>

<div class="page-header animate-fade-in">
    <div>
        <h1>猜歌</h1>
    </div>
</div>

<!-- 開始畫面:說明 + 選玩法 -->
<div class="game-panel glass-panel animate-fade-in" id="game-setup">
    <div class="game-setup-grid">

        <!-- 左:怎麼玩 -->
        <div class="game-guide">
            <h2 class="game-guide-title">怎麼玩</h2>

            <ol class="game-steps">
                <li>
                    <b>填歌手按「載入」</b>
                    <span>四個選項<b>全是這位歌手的歌</b>，不能靠「歌手不對」刷掉。曲目取自 iTunes 日本區（日文原名）。</span>
                </li>
                <li>
                    <b>在播放器放這位歌手的歌</b>
                    <span>Spotify、YouTube 都行。<b>題目就是實際播到的那首</b> —— 放別人的歌會跟選項對不起來。</span>
                </li>
                <li>
                    <b>回這頁按「開始」</b>
                    <span>自動開隨機播放，切下一首當第一題。</span>
                </li>
                <li>
                    <b>只靠耳朵作答</b>
                    <span>歌名、封面、歌詞、靈動島、側欄、播放列全部收起來，答完 3 秒換下一題。
                        <b>「結束」是唯一的出口</b>（跳過＝當作答錯）。</span>
                </li>
            </ol>

            <div class="game-guide-block">
                <h3>怎麼算分</h3>
                <p>答對 = <b>基本 1＋速度＋連勝</b>，三項相加；<b>答錯 −1</b>，<b>跳過 0</b>（不扣也不加）。</p>
                <p><b>速度</b>最多 +5，<b>每 10 秒剩一半</b>（1 秒 +4.7、5 秒 +3.5、10 秒 +2.5、30 秒 +0.6），
                    吃實際秒數，永遠不歸零，<b>答得慢不扣分</b>。<b>連勝</b>第 2 題起每題 +1，上限 +5，答錯歸零。</p>
                <p class="game-note">遊戲中的播放<b>不會</b>寫進聆聽紀錄；隨機播放結束後不會改回原設定。</p>
            </div>
        </div>

        <!-- 右:選玩法 + 開始 -->
        <div class="game-choose">
            <h2 class="game-guide-title">選玩法</h2>

            <div class="game-setup-row">
                <span class="game-setup-label">考哪位歌手</span>
                <!-- 輸入區與歌手卡**互斥**:載入成功後只留卡片,免得右欄長到要捲動 -->
                <div id="game-artist-pick">
                    <div class="game-artist-input">
                        <input type="text" id="game-artist-name" placeholder="日文原名、羅馬字都可以查">
                        <button class="game-btn-ghost" id="game-artist-load">載入</button>
                    </div>
                    <!-- 最近載入過的三位,點一下重載 -->
                    <div class="game-artist-recent hidden" id="game-artist-recent"></div>
                </div>

                <!-- 載入成功的歌手卡:大字 + 封面照,一眼看得出這局考誰 -->
                <div class="game-artist-card hidden" id="game-artist-card">
                    <img id="game-artist-img" alt="" hidden>
                    <div class="game-artist-meta">
                        <span class="game-artist-title" id="game-artist-title"></span>
                        <span class="game-artist-sub" id="game-artist-count"></span>
                    </div>
                    <button class="game-link-btn" id="game-artist-clear">換一位</button>
                </div>

                <p class="game-setup-hint" id="game-artist-status"></p>
            </div>

            <div class="game-setup-row">
                <span class="game-setup-label">一局多長</span>
                <div class="mode-tabs" id="game-modes">
                    <button class="mode-tab active" data-mode="10"><i class="fa-solid fa-list-ol"></i> 10 題</button>
                    <button class="mode-tab" data-mode="endless"><i class="fa-solid fa-infinity"></i> 無限</button>
                    <button class="mode-tab" data-mode="lives"><i class="fa-solid fa-heart"></i> 三條命</button>
                    <button class="mode-tab" data-mode="full"><i class="fa-solid fa-list-check"></i> 全曲目</button>
                </div>
                <p class="game-setup-hint">
                    <b>10 題</b>答滿結算・<b>無限</b>按結束才停・<b>三條命</b>錯或跳過扣一條<br>
                    <b>全曲目</b>每首考一次，考過的自動跳過 ——
                    <b>你的播放清單要涵蓋全部曲目</b>，缺的歌不會出現。
                </p>
            </div>

            <div class="game-setup-row">
                <span class="game-setup-label">從哪裡開始播</span>
                <div class="mode-tabs" id="game-starts">
                    <button class="mode-tab active" data-start="intro"><i class="fa-solid fa-backward-fast"></i> 前奏</button>
                    <button class="mode-tab" data-start="random"><i class="fa-solid fa-shuffle"></i> 隨機時間</button>
                </div>
                <p class="game-setup-hint">
                    <b>前奏</b>從頭播・<b>隨機時間</b>跳到中段某處，前奏背再熟也沒用。
                </p>
            </div>

            <button class="game-btn-primary" id="game-start" disabled><i class="fa-solid fa-play"></i> 開始</button>
            <p class="game-setup-hint game-setup-ready">按之前先確認播放器<b>正在放這位歌手的歌</b>。</p>
        </div>
    </div>
</div>

<!-- 出題畫面 -->
<div class="game-panel glass-panel animate-fade-in hidden" id="game-play">
    <div class="game-hud">
        <span id="game-progress">第 1 題</span>
        <span id="game-score">0 分</span>
        <span id="game-lives" class="hidden"></span>
    </div>

    <div class="game-body">
        <div class="game-left">
            <div class="game-stage" id="game-stage">
                <div class="game-listening">
                    <i class="fa-solid fa-compact-disc game-disc"></i>
                    <div class="game-bigtimer" id="game-timer">0.0 秒</div>
                    <div class="game-bigstreak hidden" id="game-streak"></div>
                </div>
                <div class="game-reveal hidden" id="game-reveal"></div>

                <!-- 播放進度。歌名藏著,但「這首多長、播到哪」不算洩答案,還能看出快到尾了 -->
                <div class="game-track hidden" id="game-track">
                    <div class="game-track-bar"><div class="game-track-fill" id="game-track-fill"></div></div>
                    <div class="game-track-time">
                        <span id="game-track-pos">0:00</span>
                        <span id="game-track-dur">0:00</span>
                    </div>
                </div>
            </div>

            <!-- 本局戰績:每答一題疊一列 -->
            <div class="game-log" id="game-log"></div>
        </div>

        <div class="game-right">
            <div class="game-options" id="game-options"></div>
            <div class="game-actions">
                <button class="game-btn-ghost" id="game-skip"><i class="fa-solid fa-forward"></i> 跳過</button>
                <button class="game-btn-ghost" id="game-quit"><i class="fa-solid fa-flag-checkered"></i> 結束</button>
            </div>
        </div>
    </div>
</div>

<!-- 結算畫面 -->
<div class="game-panel glass-panel animate-fade-in hidden" id="game-over">
    <h2 id="game-result-score">0 分</h2>
    <p id="game-result-line" class="game-note"></p>
    <div class="game-wrong" id="game-wrong"></div>
    <!-- 全曲目玩法:清單裡缺的歌永遠不會出現,所以要把「沒考到的」列出來 -->
    <div class="game-wrong" id="game-missing"></div>
    <div class="game-actions">
        <button class="game-btn-primary" id="game-again"><i class="fa-solid fa-rotate-right"></i> 再玩一局</button>
        <button class="game-btn-ghost" id="game-remode"><i class="fa-solid fa-sliders"></i> 重選模式</button>
    </div>
</div>

<script src="/js/song-key.js?v=1"></script>
<script src="/js/game-score.js?v=3"></script>
<script src="/js/game.js?v=14"></script>

<%- include('footer') %>
